# =========================================================
# BeatHub environment configuration
# Copy this file to .env and fill in your own values.
# NEVER commit a real .env file with live secrets to source control.
# =========================================================

# --- Core ---
APP_ENV=development
APP_NAME=BeatHub
SECRET_KEY=replace-this-with-a-long-random-string
DATABASE_URL=postgresql://user:password@localhost:5432/beathub
BASE_URL=http://localhost:8000

# --- Auth ---
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Platform economics ---
# Percentage BeatHub keeps from every completed sale (creator keeps the rest).
PLATFORM_COMMISSION_PERCENT=10

# --- Paystack: Kenya M-PESA + card checkout ---
# Keep the secret key server-side only. Use Paystack test keys in development.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# --- Flutterwave ---
# Optional separate gateway retained for existing non-track features/compatibility.
FLW_SECRET_KEY=
FLW_SECRET_HASH=
FLW_BASE_URL=https://api.flutterwave.com

# --- Stripe compatibility (optional / legacy) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_KES_TO_USD_RATE=0

# --- Social links (shown on the creator dashboard) ---
YOUTUBE_CHANNEL_ID=UCj0OSnxkdYsuhMipfKqLKnw
DISCORD_INVITE_URL=

# --- Email (optional — password reset emails etc.) ---
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=

# --- Media storage ---
MEDIA_STORAGE=local
MEDIA_ROOT=media
MAX_UPLOAD_MB=50
