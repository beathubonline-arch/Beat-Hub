# =========================================================
# BeatHub environment configuration
# Copy this file to .env and fill in your own values.
# NEVER commit a real .env file with live secrets to source control.
# =========================================================

# --- Core ---
APP_ENV=development
APP_NAME=BeatHub
SECRET_KEY=replace-this-with-a-long-random-string
DATABASE_URL=postgresql://user:password@localhost:5432/beathub
BASE_URL=http://localhost:8000

# --- Auth ---
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Platform economics ---
# Percentage BeatHub keeps from every completed sale (creator keeps the rest).
PLATFORM_COMMISSION_PERCENT=10

# --- M-Pesa Daraja (Safaricom) ---
# Get these from https://developer.safaricom.co.ke after creating an app.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Must be a PUBLIC https URL Safaricom can reach, e.g.
# https://your-app.onrender.com/mpesa/callback
MPESA_CALLBACK_URL=

# --- Social links (shown on the creator dashboard) ---
YOUTUBE_CHANNEL_ID=UCj0OSnxkdYsuhMipfKqLKnw
DISCORD_INVITE_URL=

# --- Email (optional — password reset emails etc.) ---
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=

# --- Media storage ---
MEDIA_STORAGE=local
MEDIA_ROOT=media
MAX_UPLOAD_MB=50
