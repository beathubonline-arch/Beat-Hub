# =========================================================
# BeatHub environment configuration
# Copy this file to .env and fill in your own values.
# NEVER commit a real .env file with live secrets to source control.
# =========================================================

# --- Core ---
APP_ENV=development
APP_NAME=BeatHub
SECRET_KEY=replace-this-with-a-long-random-string
SESSION_SECRET=replace-this-with-another-long-random-string
DATABASE_URL=postgresql://user:password@localhost:5432/beathub
BASE_URL=http://localhost:8000

# --- Auth ---
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Platform economics ---
# Immutable marketplace rule: 10% BeatHub / 90% creator.
PLATFORM_COMMISSION_PERCENT=10

# --- Paystack: single Kenya payment gateway ---
# Paystack Checkout provides cards and Kenya M-PESA/mobile-money channels.
# Keep the secret key server-side only. Use Paystack test keys in development.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# --- Social links ---
YOUTUBE_CHANNEL_ID=UCj0OSnxkdYsuhMipfKqLKnw
DISCORD_INVITE_URL=

# --- Email ---
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=

# --- Media storage ---
MEDIA_STORAGE=r2
MEDIA_ROOT=media
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=beathub
R2_PUBLIC_URL=
R2_PUBLIC_URL_EXPIRES=3600
R2_DOWNLOAD_URL_EXPIRES=900
MAX_UPLOAD_MB=50
