{
  "expo": {
    "name": "BeatHub",
    "slug": "beathub",
    "version": "1.0.0",
    "icon": "./assets/beathub-icon.png",
    "orientation": "portrait",
    "scheme": "beathub",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/beathub-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#08070D"
    },
    "plugins": [
      "expo-router",
      ["expo-audio", { "microphonePermission": false, "recordAudioAndroid": false, "enableBackgroundRecording": false, "enableBackgroundPlayback": false }]
    ],
    "android": {
      "package": "com.beathub.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/beathub-adaptive-foreground.png",
        "backgroundColor": "#08070D"
      }
    },
    "ios": {
      "bundleIdentifier": "com.beathub.app",
      "buildNumber": "1"
    },
    "extra": {
      "apiBaseUrl": "https://mybeathub.com/api/v1"
    }
  }
}
